    "is_threshold_security": { "type": "boolean" },
    "is_margin_account": { "type": "boolean" },
    "margin_available": { "type": "number" },
    "required_margin": { "type": "number" },
    "is_registered_fund": { "type": "boolean" },
    "sector_pct": { "type": "number" },
    "is_banking_entity": { "type": "boolean" },
    "is_prop_trade": { "type": "boolean" },
    "is_restricted_security_rule144": { "type": "boolean" },
