      { "condition": { "type": "simple", "inputVariable": "is_banking_entity", "name": "Banking Entity" }, "columnId": "c4" },
      { "condition": { "type": "simple", "inputVariable": "is_prop_trade", "name": "Prop Trade" }, "columnId": "c5" },
      { "output": { "outputVariable": "ruleId" }, "columnId": "o1" },
      { "output": { "outputVariable": "ruleName" }, "columnId": "o2" },
      { "output": { "outputVariable": "jurisdiction" }, "columnId": "o3" },
      { "output": { "outputVariable": "status" }, "columnId": "o4" },
