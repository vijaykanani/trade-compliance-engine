# DecisionRules.io Configuration
DECISION_RULES_API_KEY=your-decisionrules-api-key-here
DECISION_RULES_BASE_URL=https://api.decisionrules.io

# Rule IDs from your DecisionRules.io workspace
DR_RULE_ID_PRE_TRADE_CORPORATE=your-rule-id
DR_RULE_ID_PRE_TRADE_USA=your-rule-id
DR_RULE_ID_PRE_TRADE_EMEA=your-rule-id
DR_RULE_ID_POST_TRADE_CORPORATE=your-rule-id
DR_RULE_ID_POST_TRADE_USA=your-rule-id
DR_RULE_ID_POST_TRADE_EMEA=your-rule-id

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=your-secret-key-change-in-production

# Database
DATABASE_URL=sqlite+aiosqlite:///./compliance.db

# Streamlit
API_BASE_URL=http://localhost:8000

# Use local fallback rules if DecisionRules.io not configured
USE_LOCAL_RULES_FALLBACK=true

# Alert Configuration (optional)
ALERT_EMAIL=compliance@yourfirm.com
SLACK_WEBHOOK_URL=https://hooks.slack.com/your-webhook
